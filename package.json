{
  "name": "handshake-dungeon-core-server",
  "version": "1.0.0",
  "private": true,
  "description": "Authoritative Socket.IO server for the Cooperative Dungeon Core Crawler",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "check": "node scripts/check-js.js",
